# ServiceFind backend environment variables
# Copy this file to backend/.env and adjust values before running locally.
# Never commit backend/.env; it is listed in .gitignore.

APP_NAME=servicefind-api
VERSION=0.1.0
APP_ENV=development

# MongoDB Atlas connection string.
# Obtain this from your MongoDB Atlas cluster (Connect -> Drivers -> Python).
# Example format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave empty if you do not want to connect to a database yet.
MONGODB_URI=mongodb+srv://servicefind:<Yitu8727@cluster0.ibjj7is.mongodb.net/

# Name of the database to use within the cluster.
DATABASE_NAME=servicefind

# Server selection timeout in milliseconds for the MongoDB client.
MONGODB_TIMEOUT_MS=5000
